# Dia chi ESP32 trong mang Wi-Fi (co the sua lai trong trang Cai dat)
ESP32_HOST=canhbao-tenga.local

# Chi can khi ban dat mat khau cho trang web firmware (WEB_USER/WEB_PASS trong secrets.h)
# ESP32_USER=
# ESP32_PASS=

# ---- Tro ly AI (Groq, mien phi, rat nhanh) ----
# Dung cho: chat hoi tham suc khoe, AI nhan xet trang Tong quan, bien tap loi nhan
# doc ra loa, tro ly giong noi tren ESP32. Lay key o https://console.groq.com/keys
GROQ_API_KEY=

# ---- Bot Telegram hai chieu (cung bot voi firmware) ----
# Khi dashboard chay, no "thue" quyen doc tin cua bot tu ESP32 de tra loi bang AI va
# doc lenh /hoitham ra loa. Tat dashboard thi ESP32 tu tra loi nhu cu.
# TELEGRAM_BOT_TOKEN=123456789:AA...      (giong TELEGRAM_BOT_TOKEN trong secrets.h)
# TELEGRAM_CHAT_ID=123456789              (chat duoc phep, giong secrets.h)
# Them nguoi nha / nhom gia dinh khac (cach nhau dau phay; nhom la so am):
# TELEGRAM_ALLOWED_CHAT_IDS=111111111,-1001234567890
# Tat han bot cua dashboard (de ESP32 tu tra loi):
# TELEGRAM_BOT_DISABLED=1

# ---- Nhan xet bao cao bang AI (tuy chon, chon MOT trong hai) ----
# Claude: chat luong viet tot nhat, tra phi nhung rat re (~0,05-0,1 USD / lan)
# ANTHROPIC_API_KEY=sk-ant-...
# Google Gemini: co bac mien phi, lay key o https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Thu muc luu du lieu (mac dinh: dashboard/data). Doi khi muon chay thu ma khong
# dung vao so lieu that.
# DASHBOARD_DATA_DIR=data
