/**
 * @file secrets.h.example
 * @brief Mẫu file khai báo thông tin riêng tư.
 *
 * CÁCH DÙNG: copy file này thành include/secrets.h rồi điền thông tin của bạn.
 *            File secrets.h đã được .gitignore bỏ qua để không bị đẩy lên GitHub.
 *
 *   copy include\secrets.h.example include\secrets.h     (Windows)
 */
#pragma once

// ------------------------------- Wi-Fi --------------------------------------
// ESP32 chỉ bắt được Wi-Fi 2,4 GHz. Nếu router phát chung tên cho cả 2,4 và 5 GHz
// mà không kết nối được thì hãy tách tên mạng 2,4 GHz ra riêng.
// Wi-Fi nay chi la MANG MOI ban dau. Thiet bi luu nhieu Wi-Fi va them/xoa
// duoc ngay tren trang web; mat het mang da luu thi thiet bi tu bat AP cau hinh.
#define WIFI_SSID      "TEN_WIFI_CUA_BAN"
#define WIFI_PASSWORD  "MAT_KHAU_WIFI"

// ------------------------------ Telegram ------------------------------------
// 1. Mở Telegram, chat với @BotFather -> /newbot -> lấy token
// 2. Chat một câu bất kỳ với bot vừa tạo, rồi mở:
//    https://api.telegram.org/bot<TOKEN>/getUpdates  -> lấy "chat":{"id":...}
//    (Muốn gửi vào nhóm gia đình: thêm bot vào nhóm, chat 1 câu, chat id sẽ là số âm)
// 3. Nhiều người nhận: ghi các chat id cách nhau dấu phẩy, ví dụ "111111111,222222222".
//    Mỗi người phải nhắn cho bot một câu (bấm Start) trước thì bot mới gửi được.
#define TELEGRAM_BOT_TOKEN  "123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#define TELEGRAM_CHAT_ID    "123456789"

// --------------------------- Email qua Resend -------------------------------
// Kênh cảnh báo thứ hai (song song với Telegram). Để RESEND_API_KEY = "" nếu
// không dùng email.
//
// CÁCH LẤY:
//   1. Đăng ký tài khoản ở https://resend.com (miễn phí 3.000 email/tháng)
//   2. Vào mục API Keys -> tạo key, dán vào RESEND_API_KEY (bắt đầu bằng "re_")
//   3. Người nhận: EMAIL_TO là email người thân sẽ nhận cảnh báo.
//
// LƯU Ý QUAN TRỌNG (hay vướng nhất):
//   - Khi CHƯA xác minh tên miền riêng, Resend bắt buộc gửi TỪ
//     "onboarding@resend.dev" và CHỈ gửi được TỚI chính email đã đăng ký tài
//     khoản Resend (gửi địa chỉ khác sẽ bị trả lỗi 403). Để demo cho nhanh,
//     đặt EMAIL_TO = đúng email bạn đăng ký Resend.
//   - Muốn gửi tới email bất kỳ: vào Resend thêm và xác minh tên miền của bạn,
//     rồi đổi EMAIL_FROM thành địa chỉ thuộc tên miền đó.
#define RESEND_API_KEY   ""                        // "re_xxxxxxxx" — để "" nếu không dùng
#define EMAIL_FROM       "onboarding@resend.dev"   // đổi sau khi đã xác minh tên miền
#define EMAIL_TO         "ban@example.com"         // email người thân nhận cảnh báo

// ------------------------- Zalo Bot (tùy chọn) ------------------------------
// Kênh song song với Telegram, dùng Zalo CÁ NHÂN của người nhà. Đây là Zalo Bot
// Platform CHÍNH THỨC (bot.zapps.me) — miễn phí, không cần Zalo OA doanh nghiệp,
// cách dùng gần y hệt bot Telegram. KHÔNG phải "tự động hóa" tài khoản cá nhân
// bằng công cụ lậu (dễ bị khóa nick).
//
// CÁCH LẤY:
//   1. Mở Zalo, tìm Official Account "Zalo Bot Manager" -> bấm "Tạo bot" trong menu
//      chat. Tên bot phải bắt đầu bằng "Bot", ví dụ "Bot OALPHA". Tạo xong, Zalo
//      nhắn Bot Token về chính tài khoản của bạn -> dán vào ZALO_BOT_TOKEN.
//   2. Nạp firmware, rồi MỖI người nhà mở bot trên Zalo và nhắn một câu bất kỳ:
//      bot trả lời kèm "Mã chat Zalo" của người đó (một chuỗi chữ số, ví dụ
//      3becaa50ae12474c1e03) -> ghi vào ZALO_CHAT_ID rồi nạp lại firmware.
//      Nhiều người: cách nhau dấu phẩy. Người chưa nhắn cho bot lần nào thì bot
//      không gửi tới được (giống Telegram).
//   3. Dùng chung một bot cho dashboard: chép token + mã chat sang dashboard/.env.local
//      (ZALO_BOT_TOKEN, ZALO_CHAT_ID).
// Để "" nếu không dùng Zalo.
#define ZALO_BOT_TOKEN   ""                        // "1234567890:AbCdEf..." do Zalo Bot Manager gửi
#define ZALO_CHAT_ID     ""                        // "3becaa50ae12474c1e03,49270a5f8f1c66423f0d"

// ------------------- Mật khẩu trang web giám sát (tùy chọn) ------------------
// Để trống ("") nếu không muốn đặt mật khẩu khi demo.
#define WEB_USER  ""
#define WEB_PASS  ""

// ------------------- Nút SOS đeo tay 433 MHz (tùy chọn) ---------------------
// Để 0 trong lần nạp đầu: firmware sẽ in mã của mọi nút bấm nhận được ra cổng
// serial. Bấm nút của bạn, copy con số in ra, dán vào đây rồi nạp lại. Làm vậy
// để remote của nhà bên cạnh bấm cũng không kích hệ thống của bạn.
#define RF_REMOTE_CODE_1  0
// Nút thứ hai (nếu mua 2 cái, ví dụ một cho cụ ông một cho cụ bà). Để 0 nếu không dùng.
#define RF_REMOTE_CODE_2  0

// ----------------------- Tên người được giám sát ----------------------------
// Dùng trong nội dung tin nhắn cảnh báo.
#define PATIENT_NAME  "Bà Nguyễn Thị A"
#define DEVICE_PLACE  "Phòng ngủ tầng 1"
